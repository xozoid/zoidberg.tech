---
import Crumbs from "src/components/Crumbs.astro";
import { logSlug, sortedLogs } from "src/data/logs";
import BaseLayout from "src/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Logs | zoidberg.tech"
  description="Chronological notes from zoidberg.tech."
>
  <main class="mx-auto w-full max-w-4xl space-y-2 md:space-y-4">
    <section class="box">
      <Crumbs />
      <h1>Logs</h1>
      <subtitle>
        Engineering journal, project updates, experiments, & thoughts
      </subtitle>
    </section>

    <section
      class="relative ml-8 space-y-2 border-l-2 border-secondary md:space-y-4"
      aria-label="Log entries"
    >
      <div
        class="absolute bottom-0 -left-4.25 m-0 h-8 w-8 rounded-full border-2 border-secondary bg-secondary"
      >
      </div>
      {
        sortedLogs.map((log) => (
          <article class="relative flex">
            <div class="absolute -left-4.25 h-8 w-8 rounded-full border-2 border-secondary bg-surface" />
            <time
              class="mt-4 shrink-0 border-t-2 border-secondary pr-2 pl-8 font-mono text-secondary"
              datetime={log.date}
            >
              {new Date(`${log.date}T00:00:00`).toLocaleDateString("en-US", {
                month: "short",
                day: "numeric",
                year: "numeric",
              })}
            </time>
            <div class="grow space-y-2 box">
              <div class="flex items-baseline gap-3">
                <h2 class="grow">{log.title}</h2>
                <icon class="shrink-0 text-secondary">{log.icon}</icon>
              </div>
              <h3 class="text-sm text-on-surface-variant">
                {"Project: "}
                <a href={log.project.href} class="hover:underline">
                  {log.project.label}
                </a>
              </h3>
              <p class="prose">{log.summary}</p>
              <div class="flex flex-wrap gap-1 md:gap-2">
                {log.tags.slice(0, -1).map((tag) => (
                  <a
                    href={`/logs?tag=${encodeURIComponent(tag.toLowerCase())}`}
                    class="btn-chip"
                  >
                    {tag}
                  </a>
                ))}
                <div class="flex grow gap-1 md:gap-2">
                  {log.tags.slice(-1).map((tag) => (
                    <a
                      href={`/logs?tag=${encodeURIComponent(tag.toLowerCase())}`}
                      class="btn-chip"
                    >
                      {tag}
                    </a>
                  ))}

                  <a
                    href={`/logs/${logSlug(log)}`}
                    class="ml-auto btn-text w-fit"
                  >
                    <span>Open</span>
                    <icon>arrow_forward</icon>
                  </a>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </section>
  </main>
</BaseLayout>
