---
import Crumbs from "src/components/Crumbs.astro";
import { logSlug, sortedLogs } from "src/data/logs";
import BaseLayout from "src/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Logs | zoidberg.tech"
  description="Chronological notes from zoidberg.tech."
>
  <main class="mx-auto w-full max-w-4xl space-y-2 md:space-y-4">
    <section class="box">
      <Crumbs />
      <h1>Logs</h1>
      <subtitle>
        Engineering journal, project updates, experiments, & thoughts
      </subtitle>
    </section>

    <section
      class="relative ml-3 space-y-6 border-l-2 border-secondary md:ml-4"
      aria-label="Log entries"
    >
      {
        sortedLogs.map((log, index) => (
          <article class="relative flex flex-wrap">
            {index === sortedLogs.length - 1 && (
              <div class="absolute -left-3.25 h-full w-6 bg-surface md:-left-4.25 md:w-8" />
            )}
            <div class="absolute -left-3.25 h-6 w-6 rounded-full border-2 border-secondary bg-surface md:-left-4.25 md:h-8 md:w-8" />
            <time
              class="mr-2 shrink-0 pl-4 font-mono text-secondary md:mt-1 md:w-36 md:text-right"
              datetime={log.date}
            >
              {new Date(`${log.date}T00:00:00`).toLocaleDateString("en-US", {
                month: "short",
                day: "numeric",
                year: "numeric",
              })}
            </time>
            <div class="grow space-y-2 box max-md:ml-3">
              <div class="flex items-baseline gap-3">
                <h2 class="grow">{log.title}</h2>
                <icon class="shrink-0 text-secondary">{log.icon}</icon>
              </div>
              <a
                href={log.project.href}
                class="text-on-surface-variant hover:underline"
              >
                {log.project.label}
              </a>
              <p class="prose">{log.summary}</p>
              <div class="flex flex-wrap gap-1 md:gap-2">
                {log.tags.slice(0, -1).map((tag) => (
                  <a
                    href={`/logs?tag=${encodeURIComponent(tag.toLowerCase())}`}
                    class="btn-chip"
                  >
                    {tag}
                  </a>
                ))}
                <div class="flex grow gap-1 md:gap-2">
                  {log.tags.slice(-1).map((tag) => (
                    <a
                      href={`/logs?tag=${encodeURIComponent(tag.toLowerCase())}`}
                      class="btn-chip"
                    >
                      {tag}
                    </a>
                  ))}

                  <a
                    href={`/logs/${logSlug(log)}`}
                    class="ml-auto btn-text w-fit"
                  >
                    <span>Open</span>
                    <icon>arrow_forward</icon>
                  </a>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </section>
  </main>
</BaseLayout>
