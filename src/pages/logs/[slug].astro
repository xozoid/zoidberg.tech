---
import type { LogDetailBlock, LogDetailImage } from "src/content/logs/types";
import Crumbs from "src/components/Crumbs.astro";
import OptimizedImage from "src/components/OptimizedImage.astro";
import { logSlug, sortedLogs } from "src/data/logs";
import BaseLayout from "src/layouts/BaseLayout.astro";

function isLogDetailImage(detail: LogDetailBlock): detail is LogDetailImage {
  return typeof detail !== "string" && detail.type === "image";
}

export function getStaticPaths() {
  return sortedLogs.map((log) => {
    return { params: { slug: logSlug(log) } };
  });
}

function logHref(log: (typeof sortedLogs)[number]): string {
  return `/logs/${logSlug(log)}`;
}

const logIndex = sortedLogs.findIndex(
  (log) => logSlug(log) === Astro.params.slug,
);
const log = sortedLogs[logIndex];

if (!log) {
  throw new Error(`No log entry found for ${Astro.params.slug}`);
}

const newerLog = sortedLogs[logIndex - 1];
const olderLog = sortedLogs[logIndex + 1];
---

<BaseLayout
  title={`${log.title} | zoidberg.tech`}
  description={log.summary.join(" ")}
>
  <main class="mx-auto w-full max-w-4xl space-y-2 md:space-y-4">
    <div class="flex items-start gap-2 max-md:flex-wrap md:gap-4">
      <section class="grow-3 box">
        <Crumbs />
        <div class="flex items-baseline justify-between gap-3">
          <h1>{log.title}</h1>
          <icon class="text-secondary">{log.icon}</icon>
        </div>
        <div class="text-on-surface-variant">
          {"Project: "}
          <a href={log.project.href} class="hover:underline">
            {log.project.label}
          </a>
        </div>
        <time class="shrink-0 font-mono text-secondary" datetime={log.date}>
          {
            new Date(`${log.date}T00:00:00`).toLocaleDateString("en-US", {
              month: "short",
              day: "numeric",
              year: "numeric",
            })
          }
        </time>
        <p class="prose">{log.summary.join(" ")}</p>
        <div class="mt-3 flex flex-wrap gap-1 md:gap-2">
          {
            log.tags.map((tag) => (
              <a
                href={`/logs?tag=${encodeURIComponent(tag.toLowerCase())}`}
                class="btn-chip"
              >
                {tag}
              </a>
            ))
          }
        </div>
      </section>
      <section class="min-w-64 shrink-0 grow box">
        <h2>Signals</h2>
        <dl class="space-y-3">
          {
            log.stats.map((stat) => (
              <div>
                <dt class="text-secondary uppercase">{stat.label}</dt>
                <dd class={"class" in stat ? stat.class : undefined}>
                  {stat.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>

    <section class="mx-auto w-fit box">
      <div class="prose">
        {
          log.details.map((detail) =>
            isLogDetailImage(detail) ? (
              <OptimizedImage
                src={detail.src}
                alt={detail.alt}
                caption={detail.caption}
              />
            ) : (
              <Fragment set:html={detail} />
            ),
          )
        }
      </div>
    </section>

    {
      (newerLog || olderLog) && (
        <nav
          class="grid gap-2 md:grid-cols-2 md:gap-4"
          aria-label="Log navigation"
        >
          {olderLog ? (
            <a class="group box" href={logHref(olderLog)}>
              <span class="font-mono text-sm text-secondary">Older log</span>
              <span class="mt-1 flex items-center gap-2 text-lg">
                <icon>arrow_back</icon>
                {olderLog.title}
              </span>
            </a>
          ) : (
            <div />
          )}
          {newerLog && (
            <a class="group box text-right" href={logHref(newerLog)}>
              <span class="font-mono text-sm text-secondary">Newer log</span>
              <span class="mt-1 flex items-center justify-end gap-2 text-lg">
                {newerLog.title}
                <icon>arrow_forward</icon>
              </span>
            </a>
          )}
        </nav>
      )
    }
  </main>
</BaseLayout>
