---
import type { ImageMetadata } from "astro";
import Crumbs from "src/components/Crumbs.astro";
import LogsTimeline from "src/components/LogsTimeline.astro";
import OptimizedImage from "src/components/OptimizedImage.astro";
import { artifacts, type ArtifactSlug } from "src/data/artifacts";
import { sortedLogs } from "src/data/logs";
import BaseLayout from "src/layouts/BaseLayout.astro";

type ArtifactDetailImage = {
  type: "image";
  src: ImageMetadata;
  alt: string;
  caption?: string;
  size?: "sm" | "md" | "lg";
};

type ArtifactDetailBlock = string | ArtifactDetailImage;

function isOptimizedImageDetail(
  detailBlock: ArtifactDetailBlock,
): detailBlock is ArtifactDetailImage {
  return typeof detailBlock !== "string" && detailBlock.type === "image";
}

export function getStaticPaths() {
  return Object.keys(artifacts).map((slug) => ({
    params: { slug },
  }));
}

const artifact = artifacts[Astro.params.slug as ArtifactSlug];
const detailBlocks = (
  Array.isArray(artifact.details) ? artifact.details : [artifact.details]
) as readonly ArtifactDetailBlock[];
const artifactLogs = sortedLogs
  .filter((log) => log.project?.href === `/artifacts/${Astro.params.slug}`)
  .reverse();
---

<BaseLayout
  title={`${artifact.title} | zoidberg.tech`}
  description={`${artifact.title} project notes and artifacts.`}
>
  <main class="mx-auto w-full max-w-4xl space-y-2 md:space-y-4">
    <div class="flex items-start gap-2 max-md:flex-wrap md:gap-4">
      <section class="grow-3 box">
        <Crumbs />
        <div class="flex items-baseline justify-between gap-3">
          <h1>{artifact.title}</h1>
          <icon class="text-secondary">{artifact.icon}</icon>
        </div>
        <p class="prose">{artifact.summary.join(" ")}</p>
        {
          artifact.links && (
            <div class="mt-3 flex gap-3">
              {artifact.links.map((link) => (
                <a class="btn-filled" href={link.href}>
                  {link.icon && <icon>{link.icon}</icon>}
                  {link.label}
                </a>
              ))}
            </div>
          )
        }
        <div class="mt-3 flex flex-wrap gap-1 md:gap-2">
          {
            artifact.tags.map((tag) => (
              <a
                href={`/search?q=${encodeURIComponent(tag.toLowerCase())}`}
                class="btn-chip"
              >
                {tag}
              </a>
            ))
          }
        </div>
      </section>
      <section class="min-w-64 shrink-0 grow box">
        <h2>Signals</h2>
        <dl class="space-y-3">
          {
            artifact.stats.map((stat) => (
              <div>
                <dt class="text-secondary uppercase">{stat.label}</dt>
                <dd class={"class" in stat ? stat.class : undefined}>
                  {stat.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>

    <section class="box">
      <div class="space-y-8">
        {
          detailBlocks.map((detailBlock) =>
            isOptimizedImageDetail(detailBlock) ? (
              <OptimizedImage
                src={detailBlock.src}
                alt={detailBlock.alt}
                caption={detailBlock.caption}
                size={detailBlock.size}
              />
            ) : (
              <div class="mx-auto prose">
                <Fragment set:html={detailBlock} />
              </div>
            ),
          )
        }
      </div>
    </section>

    {
      artifactLogs.length > 0 && (
        <section class="space-y-2 md:space-y-4">
          <div class="box">
            <h2>Development log</h2>
          </div>
          <LogsTimeline logs={artifactLogs} variant="artifact" />
        </section>
      )
    }
  </main>
</BaseLayout>
