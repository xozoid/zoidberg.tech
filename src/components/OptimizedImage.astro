---
import type { ImageMetadata } from "astro";
import { getImage, Image } from "astro:assets";
import sharp from "sharp";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

type LocalImageMetadata = ImageMetadata & {
  fsPath?: string;
};

const { src, alt, caption } = Astro.props;
const largeImage = await getImage({
  src,
  width: 2400,
  format: "webp",
  quality: 90,
});
const previewWidth = 50;
const previewHeight = Math.round((src.height / src.width) * previewWidth);
const localSrc = src as LocalImageMetadata;

if (!localSrc.fsPath) {
  throw new Error(
    "OptimizedImage requires a local image imported from src/assets.",
  );
}

const previewBuffer = await sharp(localSrc.fsPath)
  .resize({ width: previewWidth })
  .webp({ quality: 35 })
  .toBuffer();
const previewDataUrl = `data:image/webp;base64,${previewBuffer.toString("base64")}`;
---

<figure>
  <a
    href={largeImage.src}
    class="not-prose optimized-image-link"
    data-optimized-image-frame
  >
    <img
      class="optimized-image-preview"
      src={previewDataUrl}
      alt=""
      width={previewWidth}
      height={previewHeight}
      aria-hidden="true"
      decoding="async"
    />
    <Image
      class="optimized-image-full"
      src={src}
      alt={alt}
      width={1600}
      widths={[480, 768, 1200, 1600]}
      sizes="(min-width: 896px) 832px, calc(100vw - 2rem)"
      format="webp"
      quality={82}
      loading="lazy"
      decoding="async"
      onload="this.closest('[data-optimized-image-frame]').classList.add('optimized-image-loaded')"
    />
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
